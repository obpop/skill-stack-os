# Local backend settings for Skill Stack.
#
# 1. Copy this file to backend/.env (that file is gitignored, so your key is never committed).
# 2. Fill in the values you want. Everything here is optional: without a key, Skill Stack runs
#    fully on its deterministic recommendations.
# 3. Restart the backend. It reads backend/.env when started with the local profile.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".

# ----- AI (optional) -----
# Turn AI on: set all four lines below. Budgets default to 0, which blocks every AI call.
# At roughly USD 0.007 per analysis, a monthly budget of 2 covers about 280 analyses.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MONTHLY_BUDGET_USD=0
AI_TOTAL_BUDGET_USD=0

# Paste your OpenAI API key here (create one at platform.openai.com, under API keys).
# Example when enabled:
#   AI_ENABLED=true
#   AI_PROVIDER=openai
#   AI_MONTHLY_BUDGET_USD=2
#   AI_TOTAL_BUDGET_USD=5
#   OPENAI_API_KEY_SKILL_STACK=sk-...
OPENAI_API_KEY_SKILL_STACK=
