# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
INTERNAL_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/auth0
NEXT_PUBLIC_EXPANDED_UNIVERSE=false
DEPLOYMENT_VERSION=local

# Backend / PostgreSQL
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/skillstack
DATABASE_USER=skillstack
DATABASE_PASSWORD=skillstack_local
FRONTEND_ORIGIN=http://localhost:3000
DEMO_SEED_ENABLED=true
DEV_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# AI is cost-disabled by default. Do not add credentials or enable paid calls without approval.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MONTHLY_BUDGET_USD=0
AI_TOTAL_BUDGET_USD=0
AI_MAX_CALLS_PER_REQUEST=1
AI_MAX_INPUT_CHARACTERS=12000
AI_MAX_CALLS_PER_USER_MONTH=20
AI_MAX_ESTIMATED_COST_PER_CALL_USD=0.05
AI_TIMEOUT_MS=8000
# The pilot adapter reads its secret exclusively from this server-side environment variable.
# Keep the placeholder empty; never commit a real key.
OPENAI_API_KEY_SKILL_STACK=
OPENAI_MODEL=gpt-6-sol
OPENAI_MAX_OUTPUT_TOKENS=1400
OPENAI_REASONING_EFFORT=low

# Durable background work. PostgreSQL is the queue; no broker is required.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_POLL_MS=750
BACKGROUND_JOB_LEASE_SECONDS=45
BACKGROUND_JOB_MAX_ACTIVE_PER_USER=2
BACKGROUND_JOB_MAX_QUEUED_TOTAL=200
BACKGROUND_JOB_RETENTION_DAYS=30
BACKGROUND_JOB_HEALTH_MAX_PENDING_AGE_SECONDS=120

# Rate limits. Production defaults are enabled; local profile defaults to disabled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_IMPORT_PER_MINUTE=6
RATE_LIMIT_ANALYSIS_PER_MINUTE=10
RATE_LIMIT_EXPORT_PER_MINUTE=2
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=120

# Production database pool/process sizing. Tune only from measured host behavior.
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
RELEASE_VERSION=local

# Production Auth0 login and resource-server validation (prod profile only)
# Put the real client secret only in an ignored .env file or deployment secret store.
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_CLIENT_AUTHENTICATION_METHOD=client_secret_post
AUTH0_ISSUER_URI=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.skillstack.local
AUTH0_FRONTEND_URI=http://localhost:3000
