# Copy to an ignored host-only file such as deploy/env.production and set mode 600.
# Never commit real values.
APP_ADDRESS=skill-stack.example.com
FRONTEND_ORIGIN=https://skill-stack.example.com
NEXT_PUBLIC_SITE_URL=https://skill-stack.example.com
RELEASE_VERSION=replace-with-commit-sha
FRONTEND_IMAGE=ghcr.io/replace-owner/skill-stack-frontend
BACKEND_IMAGE=ghcr.io/replace-owner/skill-stack-backend

DATABASE_NAME=skillstack
DATABASE_ADMIN_USER=skillstack_admin
DATABASE_ADMIN_PASSWORD=replace-with-long-random-secret
DATABASE_APP_USER=skillstack_app
DATABASE_APP_PASSWORD=replace-with-different-long-random-secret
DATABASE_MIGRATION_USER=skillstack_migrator
DATABASE_MIGRATION_PASSWORD=replace-with-third-long-random-secret

AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_CLIENT_AUTHENTICATION_METHOD=client_secret_post
AUTH0_ISSUER_URI=https://replace-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.skill-stack.example.com

# Safe production defaults. Enabling real-user AI requires separate processing and spend approval.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MONTHLY_BUDGET_USD=0
AI_TOTAL_BUDGET_USD=0
AI_MAX_ESTIMATED_COST_PER_CALL_USD=0.05
AI_TIMEOUT_MS=8000
OPENAI_API_KEY_SKILL_STACK=
OPENAI_MODEL=gpt-6-sol
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_POLL_MS=750
BACKGROUND_JOB_LEASE_SECONDS=45
BACKGROUND_JOB_MAX_ACTIVE_PER_USER=2
BACKGROUND_JOB_MAX_QUEUED_TOTAL=200
BACKGROUND_JOB_RETENTION_DAYS=30
BACKGROUND_JOB_HEALTH_MAX_PENDING_AGE_SECONDS=120

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_IMPORT_PER_MINUTE=6
RATE_LIMIT_ANALYSIS_PER_MINUTE=10
RATE_LIMIT_EXPORT_PER_MINUTE=2
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=120

DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
